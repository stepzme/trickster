{
  "name": "@sgx22/trickster",
  "version": "0.4.0",
  "description": "Project-scoped multi-agent Codex workflow for building and reviewing iOS apps",
  "type": "module",
  "bin": {
    "trickster": "bin/trickster.mjs"
  },
  "files": [
    "agents",
    "bin",
    "installer",
    "scripts",
    "templates",
    "workflow",
    "README.md"
  ],
  "scripts": {
    "preinstall": "node ./scripts/reject-global-install.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
