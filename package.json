{
  "name": "@sgx22/trickster",
  "version": "1.0.3",
  "description": "AI app factory for reference-driven native iOS apps, feedback-gated implementation, app icons, and store screenshots",
  "license": "MIT",
  "type": "module",
  "bin": {
    "trickster": "bin/trickster.mjs"
  },
  "files": [
    "adapters",
    "bin",
    "docs/assets",
    "installer",
    "roles",
    "scripts",
    "templates",
    "workflow",
    "README.md",
    "README.ru.md",
    "README.es.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "ios",
    "native-ios",
    "ai-agents",
    "app-factory",
    "design-system",
    "simulator",
    "aso",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepzme/trickster.git"
  },
  "homepage": "https://stepzme.github.io/trickster/",
  "bugs": {
    "url": "https://github.com/stepzme/trickster/issues"
  },
  "scripts": {
    "preinstall": "node ./scripts/reject-global-install.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
