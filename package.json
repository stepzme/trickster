{
  "name": "@sgx22/trixter",
  "version": "2.0.0",
  "description": "Your AI crew for native iOS development, from product definition to release materials",
  "license": "MIT",
  "type": "module",
  "bin": {
    "trixter": "bin/trixter.mjs",
    "trickster": "bin/trickster.mjs"
  },
  "files": [
    "adapters",
    "bin",
    "docs/assets",
    "installer",
    "roles",
    "scripts",
    "templates",
    "workflow",
    "README.md",
    "README.ru.md"
  ],
  "keywords": [
    "ios",
    "native-ios",
    "ai-agents",
    "app-factory",
    "design-system",
    "simulator",
    "aso",
    "codex",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepzme/trixter.git"
  },
  "homepage": "https://stepzme.github.io/trixter/",
  "bugs": {
    "url": "https://github.com/stepzme/trixter/issues"
  },
  "scripts": {
    "preinstall": "node ./scripts/reject-global-install.mjs",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "plugin:build": "node maintainers/build-plugin.mjs",
    "plugin:check": "node maintainers/build-plugin.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
